# Django
DJANGO_SECRET_KEY=troque-isto
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=10.0.0.10,produtividade.intranet

# Pasta onde estão auth.py / controller.py do ETL (entra no sys.path)
ETL_PATH=/opt/etl_vendas

# dim_calendario no Databricks
DIM_CALENDARIO_TABELA=b2c.planejamento_comercial.dim_calendario
DIM_CALENDARIO_COL_DATA=data
DIM_CALENDARIO_COL_DU_ACC=du_acc

# Quem entra no quartil (perfis da tbusuarios, separados por vírgula)
PERFIS_VENDEDOR=consultor
DOMINIO_EMAIL=@alloha.com

# Cache do resultado (segundos) — evita bater no Databricks a cada F5
CACHE_SEGUNDOS=600
